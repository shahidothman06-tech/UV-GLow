<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base window theme. Compose draws everything; this only sets dark window colors. -->
    <style name="Theme.UVGlow" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/uv_ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- System splash (Android 12+ API, back-ported by core-splashscreen). -->
    <style name="Theme.UVGlow.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/uv_ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <!-- Same dark disc as the launcher icon behind the splash artwork. -->
        <item name="windowSplashScreenIconBackgroundColor">@color/uv_icon_background</item>
        <item name="postSplashScreenTheme">@style/Theme.UVGlow</item>
    </style>
</resources>
